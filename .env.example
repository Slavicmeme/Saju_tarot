# Magic Tarot runtime configuration
APP_NAME=Magic Tarot
APP_ENV=development

# OpenAI-compatible API
# 실제 사용 시 .env 파일을 만들고 API 키를 입력하세요.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1

# 일반 타로·사주 상세 리딩 모델
LLM_MODEL=gpt-5-mini-2025-08-07

# 실시간 Agent 채팅 모델 (응답 속도 우선)
AGENT_LLM_MODEL=gpt-4.1-mini

# Request and output limits
LLM_TIMEOUT=120
LLM_MAX_COMPLETION_TOKENS=8000

# Local result/session settings
RESULT_TTL_HOURS=24
EXPOSE_LLM_STATUS=true

